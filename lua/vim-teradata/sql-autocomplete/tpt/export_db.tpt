DEFINE JOB EXPORT_DATA
DESCRIPTION 'Export data from Teradata to a file'
(
    DEFINE SCHEMA FILE_SCHEMA
    (
        full_line varchar(1024)
    );

    DEFINE OPERATOR SQL_SELECTOR
    TYPE SELECTOR
    SCHEMA FILE_SCHEMA
    ATTRIBUTES
    (
        VARCHAR SelectStmt = 'lock row for access
        select cast(upper(
               trim(c.DatabaseName)
            || '','' || trim(c.TableName)
            || '','' || trim(c.ColumnName)
            || '','' || coalesce(trim(c.ColumnType), '''')
            || '','' || coalesce(trim(c.ColumnLength), '''')
            || '','' || coalesce(trim(c.DecimalTotalDigits), '''')
            || '','' || coalesce(trim(c.DecimalFractionalDigits), '''')
            || '','' || coalesce(trim(c.CharType), '''')
            || '','' || coalesce(trim(c.Nullable), '''')
            || '','' || coalesce(trim(c.ColumnUDTName), '''')
        ) as varchar(1024))
        from DBC.TablesV t
        join DBC.ColumnsV c
          on t.DatabaseName = c.DatabaseName and t.TableName = c.TableName
        where t.TableKind in (''T'',''V'',''M'',''O'',''Q'')
        order by c.DatabaseName, c.TableName, c.ColumnId;',
        VARCHAR PrivateLogName = 'selector_log',
        VARCHAR UserName = @user,
        VARCHAR UserPassword = '$tdwallet('||@user||')',
        VARCHAR LogonMech = @logon_mech,
        VARCHAR TdpId = @tdpid,
        VARCHAR ReportModeOn = 'Y'
    );

    DEFINE OPERATOR FILE_WRITER
    TYPE DATACONNECTOR CONSUMER
    SCHEMA *
    ATTRIBUTES
    (
        VARCHAR PrivateLogName = 'dataconnector_log',
        VARCHAR DirectoryPath = @data_path,
        VARCHAR FileName = 'data_tmp.csv',
        VARCHAR Format = 'DELIMITED',
        VARCHAR OpenMode = 'Write',
        VARCHAR TextDelimiter = ','
    );

    APPLY TO OPERATOR (FILE_WRITER)
    SELECT * FROM OPERATOR (SQL_SELECTOR);
);
