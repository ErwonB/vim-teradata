USING CHARACTER SET UTF8
DEFINE JOB VTD_EXPORT_QUERY
DESCRIPTION 'vim-teradata: export a wrapped (all-VARCHAR) SELECT to a delimited file'
(
    /* All-VARCHAR schema derived from the query itself, suited to a delimited file. */
    DEFINE SCHEMA QUERY_SCHEMA FROM SELECT DELIMITED @select_stmt;

    DEFINE OPERATOR QUERY_SOURCE
    TYPE EXPORT
    SCHEMA QUERY_SCHEMA
    ATTRIBUTES
    (
        VARCHAR SelectStmt     = @select_stmt,
        VARCHAR UserName       = @user,
        VARCHAR UserPassword   = '$tdwallet('||@user||')',
        VARCHAR LogonMech      = @logon_mech,
        VARCHAR TdpId          = @tdpid,
        INTEGER MaxSessions    = @max_sessions,
        INTEGER MinSessions    = 1,
        VARCHAR PrivateLogName = 'vtd_export_log'
    );

    DEFINE OPERATOR FILE_WRITER
    TYPE DATACONNECTOR CONSUMER
    SCHEMA *
    ATTRIBUTES
    (
        VARCHAR DirectoryPath  = @data_path,
        VARCHAR FileName       = @file_name,
        VARCHAR Format         = 'DELIMITED',
        VARCHAR OpenMode       = 'WriteAppend',
        VARCHAR TextDelimiter  = @delimiter,
        VARCHAR QuotedData     = 'No',
        VARCHAR PrivateLogName = 'vtd_writer_log'
    );

    APPLY TO OPERATOR (FILE_WRITER)
    SELECT * FROM OPERATOR (QUERY_SOURCE);
);
